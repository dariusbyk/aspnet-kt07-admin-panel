@model UserForm
<h1>Добавление пользователя</h1>
<form asp-action="Create" method="post">
    <div asp-validation-summary="All" class="error"></div>
    <p><label asp-for="UserName">Логин</label><input asp-for="UserName" /></p>
    <p><label asp-for="Email">Email</label><input asp-for="Email" type="email" /></p>
    <p><label asp-for="Password">Пароль</label><input asp-for="Password" type="password" autocomplete="new-password" /></p>
    <p>Минимум 6 символов: заглавная и строчная латинские буквы, цифра и специальный символ.</p>
    <p>
        <label asp-for="Role">Роль</label>
        <select asp-for="Role">
            <option value="User">Пользователь</option>
            <option value="Admin">Администратор</option>
        </select>
    </p>
    <button type="submit">Сохранить</button>
    <a asp-action="Index">Отмена</a>
</form>
